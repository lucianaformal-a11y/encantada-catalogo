{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "encantada-catalogo",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],

   "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "69baadb7f07a4b1b8a2eb5aa7f97af82"
        }
  ],

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
