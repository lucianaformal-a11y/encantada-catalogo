{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "encantada-catalogo",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
